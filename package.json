{
  "name": "online-pos",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @online-pos/database generate",
    "db:migrate": "pnpm --filter @online-pos/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @online-pos/database migrate:deploy",
    "db:seed": "pnpm --filter @online-pos/database seed",
    "db:reset": "pnpm --filter @online-pos/database reset",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
